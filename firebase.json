{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".github/**",
      "**/node_modules/**",
      "README.md",
      "APOVIX.zip",
      "APOVIX/**",
      "hero"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "comment": "The rule above matches /about.html but not the bare '/' that serves index.html, which would otherwise fall back to Firebase's 1 hour default and delay homepage updates.",
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "comment": "The CSS and JS filenames are not fingerprinted, so a max-age of any length serves a stale build after every deploy — the browser will not even ask. max-age=0 makes it revalidate each load, which costs a 304 and nothing else.",
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "comment": "The admin panel must never be indexed or cached by a shared proxy. Access itself is enforced by Firebase Auth plus the /admins check in firestore.rules — these headers only keep it out of search results and shared caches.",
        "source": "/admin/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "Cache-Control", "value": "private, no-store" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
